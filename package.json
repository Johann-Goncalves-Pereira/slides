{
	"name": "slides",
	"version": "1.0.0",
	"description": "Obsidian plugin shell.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "vitest run",
		"validate": "sh scripts/validate",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-quality-bar": "file:./eslint-plugin-quality-bar",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"effect": "^3.18.4"
	}
}
